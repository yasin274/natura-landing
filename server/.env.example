# ── Сервер ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Разрешённые источники, через запятую. Используются и для CORS, и для проверки
# Origin при оформлении заказа.
# * — разрешить всё. Допустимо ТОЛЬКО в разработке: в проде это означает, что
# форму заказа сможет дёргать любой чужой сайт.
# Пример для прода: CORS_ORIGIN=https://natura.ru,https://www.natura.ru
CORS_ORIGIN=*

# Раздавать ли лендинг этим же процессом. false — если статику отдаёт nginx/CDN.
SERVE_STATIC=true

# ── База данных ───────────────────────────────────────────────────────────────
# Локально:    postgresql://postgres:PASSWORD@localhost:5432/natura?schema=public
# Supabase/Neon: не забудьте ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/natura?schema=public"

# ── Секреты ───────────────────────────────────────────────────────────────────
# Подпись JWT для входа в админку. Сгенерировать:  npm run keygen
JWT_SECRET="change-me-run-npm-run-keygen"
JWT_EXPIRES_IN=7d

# ── Уведомления о заказах ─────────────────────────────────────────────────────
# Токен бота от @BotFather. Хранится ТОЛЬКО здесь: всё, что попадает в код
# страницы, видно любому посетителю, а с украденным токеном можно писать
# от имени бота и читать его переписку.
# Без этих двух переменных магазин работает — заказы сохраняются в базу,
# но мгновенного уведомления владельцу не будет.
TELEGRAM_BOT_TOKEN=""
# Свой chat_id можно узнать у бота @userinfobot
TELEGRAM_CHAT_ID=""
